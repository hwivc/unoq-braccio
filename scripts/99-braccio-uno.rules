# Give the Braccio's Arduino UNO a stable name, /dev/braccio, whichever
# /dev/ttyACM* or /dev/ttyUSB* it lands on. Installed by setup_uno_serial.sh.
# If more than one matching board is plugged in, the last one wins.

# Arduino UNO R3 (genuine, ATmega16U2)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", SYMLINK+="braccio", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0001", SYMLINK+="braccio", MODE="0666"
# Arduino UNO R4 Minima / WiFi
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0069", SYMLINK+="braccio", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="1002", SYMLINK+="braccio", MODE="0666"
# UNO clones with a CH340 USB chip
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="braccio", MODE="0666"
